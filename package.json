{
  "name": "@verdeect/platform-client",
  "version": "1.1.0",
  "description": "Клиент авторизации Platform для сервисов Вердикта 2.0: решение по праву из кэша снимка, модуль NestJS, подделка Platform для тестов",
  "keywords": [
    "verdeect",
    "authz",
    "permissions",
    "platform",
    "nestjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smskin/verdeect-platform-client.git"
  },
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./nest": {
      "types": "./dist/nest/index.d.ts",
      "default": "./dist/nest/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "development": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node -e \"fs.rmSync('dist/core/limits.d.ts')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:perf": "vitest run -c vitest.perf.config.ts",
    "test:package": "vitest run -c vitest.package.config.ts",
    "test:contract": "vitest run -c vitest.contract.config.ts",
    "pack:check": "pnpm build && publint --strict && attw --pack . --profile esm-only && pnpm test:package"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@verdeect/auth": "^1.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "@verdeect/auth": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@nestjs/testing": "12.1.3",
    "@swc/core": "1.16.18",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "22.20.5",
    "@verdeect/auth": "1.0.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "amqplib": "2.2.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "65.4.0",
    "fastify": "5.12.5",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "testcontainers": "12.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.4",
    "yaml": "2.9.1"
  }
}
